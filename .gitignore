# Python (Windows venv, see dji-vcam.sh)
.venv/
__pycache__/

# Local state: BLE pairing identifier, camera AP credentials
.state/

# Phone captures (may contain credentials)
captures/

# ESP-IDF build output and generated config
firmware/*/build/
firmware/*/managed_components/
firmware/*/sdkconfig
firmware/*/sdkconfig.old

# Raw flash dumps
firmware/backups/

# Installer and packaged app outputs (only the packaging scripts are committed)
binaries/

# App build trees
app/build*/

# Tool logs
aqtinstall.log
