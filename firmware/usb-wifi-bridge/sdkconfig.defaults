# USB: NCM network interface + one CDC-ACM console port
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# Keep the ROM/boot console on UART0 only; the native USB PHY belongs to TinyUSB
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Throughput / latency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
# Frames waiting for USB keep their dynamic RX buffer (bridge.c TX_QUEUE_DEPTH = 160): with only 64,
# a USB stall during a keyframe burst exhausted them and the driver discarded frames silently.
# More than 128 needs lwIP window scaling enabled (Kconfig range; the bridge barely uses lwIP).
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=256
CONFIG_LWIP_WND_SCALE=y
# (With the Wi-Fi buffers in PSRAM the driver uses static TX buffers; TX is only ACKs and commands.)
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=16

# 8 MB octal PSRAM (ESP32-S3 N16R8): the Wi-Fi and lwIP buffers above may live there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# NCM IN transfer blocks for keyframe bursts: 6 is the maximum (3200 B each: the size proven to
# work with Windows); the frame queue in bridge.c does the deeper buffering
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=6
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=3200

# 1 ms scheduler tick: the USB pump retries after one tick
CONFIG_FREERTOS_HZ=1000

# Firmware updates over the USB console (OTA) with automatic rollback of images that never confirm
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
