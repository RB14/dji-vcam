// Windows resources of @DJIVCAM_RC_FILENAME@: its version (Explorer's Details tab) and, for the
// app, its icon. Configured by djivcam_add_version_resource() (cmake/DjiVcamVersion.cmake).
#include <winver.h>

@DJIVCAM_RC_ICON@

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS @DJIVCAM_RC_FLAGS@
FILEOS VOS_NT_WINDOWS32
FILETYPE @DJIVCAM_RC_FILETYPE@
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DJI VCam project"
            VALUE "FileDescription", "@DJIVCAM_RC_DESCRIPTION@"
            VALUE "FileVersion", "@DJIVCAM_VERSION_FULL@"
            VALUE "InternalName", "@DJIVCAM_RC_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 razboy. MIT License"
            VALUE "OriginalFilename", "@DJIVCAM_RC_FILENAME@"
            VALUE "ProductName", "DJI VCam"
            VALUE "ProductVersion", "@DJIVCAM_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
