// Windows resources of dji-vcam.exe: the app icon (also used by Qt for the windows) and the
// version shown in Explorer. Configured by CMake from the project version.
#include <winver.h>

IDI_ICON1 ICON "@DJIVCAM_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DJI VCam project"
            VALUE "FileDescription", "DJI VCam"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "dji-vcam"
            VALUE "OriginalFilename", "dji-vcam.exe"
            VALUE "ProductName", "DJI VCam"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
